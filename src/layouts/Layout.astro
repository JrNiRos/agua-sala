---
import Navbar from "../components/site/Navbar.astro";
import Footer from "../components/site/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: "es" | "en" | "fr";
}

const { title, description, lang = "es" } = Astro.props;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.pathname;

const siteUrl = "https://www.elaguasala.com";

const ld = {
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  name: "El agua salá",
  description,
  url: siteUrl,
  telephone: "+34620880212",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Villanueva del Río y Minas",
    addressRegion: "Sevilla",
    addressCountry: "ES"
  },
  image: [siteUrl + "/images/patio-2.png", siteUrl + "/images/paisaje-1.png"],
  priceRange: "€€",
  currenciesAccepted: "EUR"
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={siteUrl + "/images/patio-2.png"} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : lang === 'fr' ? 'fr_FR' : 'en_GB'} />

    <!-- Google Analytics 4: reemplaza G-XXXXXXXXXX por tu ID real -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX', { page_path: window.location.pathname });
    </script>

    <link rel="alternate" hreflang="es" href="https://www.elaguasala.com/" />
    <link rel="alternate" hreflang="en" href="https://www.elaguasala.com/en/" />
    <link rel="alternate" hreflang="fr" href="https://www.elaguasala.com/fr/" />
    <link rel="alternate" hreflang="x-default" href="https://www.elaguasala.com/" />

    <script type="application/ld+json">{JSON.stringify(ld)}</script>
  </head>
  <body class="bg-[--color-bg] text-[--color-text] antialiased">
    <Navbar lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
